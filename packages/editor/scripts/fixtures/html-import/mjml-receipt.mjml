<mjml>
  <mj-head>
    <mj-title>Your receipt</mj-title>
    <mj-attributes>
      <mj-all font-family="Arial, sans-serif" />
      <mj-text font-size="15px" line-height="22px" color="#222222" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#eeeeee" width="560px">
    <mj-wrapper background-color="#ffffff" padding="24px" border-radius="4px">
      <mj-section padding="0">
        <mj-column vertical-align="middle" width="40%">
          <mj-image src="https://cdn.example.com/brand.png" alt="Brand" width="110px" align="left" padding="0" />
        </mj-column>
        <mj-column vertical-align="middle" width="60%">
          <mj-text align="right" font-size="13px" color="#777777" padding="0">Receipt #A-1042<br/>March 3, 2026</mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="24px 0 8px">
        <mj-column>
          <mj-text font-size="22px" font-weight="bold" padding="0">Thanks for your order, {{ first_name }}</mj-text>
        </mj-column>
      </mj-section>
      <mj-section padding="0">
        <mj-column>
          <mj-table padding="0" cellpadding="6" font-size="14px">
            <tr style="border-bottom:1px solid #ecedee;text-align:left;"><th>Item</th><th style="text-align:right">Qty</th><th style="text-align:right">Price</th></tr>
            <tr><td>Standard plan</td><td style="text-align:right">1</td><td style="text-align:right">$29.00</td></tr>
            <tr><td>Extra seats</td><td style="text-align:right">3</td><td style="text-align:right">$15.00</td></tr>
          </mj-table>
        </mj-column>
      </mj-section>
      <mj-section padding="16px 0 0">
        <mj-column>
          <mj-button href="https://example.com/invoice/1042" background-color="#111111" color="#ffffff" border-radius="3px" align="left" inner-padding="10px 22px">View invoice</mj-button>
        </mj-column>
      </mj-section>
    </mj-wrapper>
    <mj-section padding="12px 0">
      <mj-column><mj-text align="center" font-size="12px" color="#888888">Questions? Reply to this email.</mj-text></mj-column>
    </mj-section>
  </mj-body>
</mjml>
